# Источник данных: blizzard (основной) | tsm
DATA_SOURCE=blizzard
TSM_GAME_TYPE=forever
TSM_REGION_SLUG=eu
TSM_REALM_SLUG=pvp-alliance

# Battle.net API (https://develop.battle.net/)
BNET_CLIENT_ID=your_bnet_client_id
BNET_CLIENT_SECRET=your_bnet_client_secret
BNET_REGION=eu
BNET_RULESET_ID=1
BNET_HOUSE_ID=113

# Экономика и параметры сбора
BANKROLL_GOLD=10.0
MAX_SHARE_PER_ITEM=0.25
SHADOW_POOL_LIMIT=250
MAX_CONTINUOUS_GAP_MINUTES=210
POLL_INTERVAL_MINUTES=30
RETENTION_DAYS=60

# Split-DB: общий облачный рынок (Neon Postgres) + личная локальная SQLite
MARKET_DATABASE_URL=postgresql://user:password@host-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
PERSONAL_DATABASE_URL=sqlite+aiosqlite:///./personal.db

# true — для read-only клиентов (роль ah_reader), отключает DDL-миграции рынка при старте
MARKET_READ_ONLY=false